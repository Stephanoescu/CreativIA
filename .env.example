# ============================================================
# CreativIA – Variables de Entorno
# Copia este archivo como .env.local y rellena los valores
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# --- IA Backend ---
# "mock" usa el MockBedrockService (sin costo).
# "real" activa el RealBedrockService con AWS (producción).
NEXT_PUBLIC_AI_PROVIDER=mock

# --- AWS Bedrock (solo se activan cuando AI_PROVIDER=real) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CLAUDE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_SD_MODEL_ID=stability.stable-diffusion-xl-v1

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

